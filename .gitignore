# ── Secrets / credentials — never commit ──────────────────────────
config.py
micropython/config.py
# Any per-unit config (config_friend1.py, config_friend2.py, ...) — the old
# rule named ONE file, so the second gift unit's WiFi creds would have been
# tracked. Only the example template is committed.
micropython/config_*.py
!micropython/config.example.py
# Credentials / signing material, by extension — defensive, none exist today.
*.pem
*.key
*.p12
*.mobileprovision
# Local personal-terms list for scripts/leakcheck.sh — MUST never be committed
# (it is the list of the things being protected).
.leakcheck-terms

# `make dev` stages the schedule here for mpremote mount.
micropython/schedule.json

# ── Schedules — the real timetable reveals where you live ─────────
# Keep everything local except the committed example template.
schedules/*
!schedules/*.example.yaml

# ── Firmware blobs (local .uf2 only) ──────────────────────────────
firmware/

# ── Vibration tuning captures — local bring-up data, not shared ───
data/

# ── Python env / caches ───────────────────────────────────────────
.venv/
__pycache__/
*.pyc
.pytest_cache/

# ── Env / editors (defensive — nothing here today, keeps it that way) ──
.env
.env.*
.vscode/
.idea/
*.swp

# ── macOS ─────────────────────────────────────────────────────────
.DS_Store

# PR body drafted for scripts/pr.sh
.pr-body.md
