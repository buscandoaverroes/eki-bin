#!/usr/bin/env bash
# Runs scripts/leakcheck.sh over exactly what is being pushed.
# Enable once per clone:  make hooks     (sets core.hooksPath=.githooks)
# Bypass in an emergency:  git push --no-verify
set -euo pipefail
zero="0000000000000000000000000000000000000000"
rc=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue                    # deleting a ref
  if [ "$rsha" = "$zero" ]; then
    # new branch: everything not already on origin's dev/main
    base="origin/dev"; git rev-parse --verify -q "$base" >/dev/null || base="origin/main"
    range="$base..$lsha"
  else
    range="$rsha..$lsha"
  fi
  scripts/leakcheck.sh --range "$range" || rc=1
done
exit $rc
